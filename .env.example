# MongoDB — base URI without relying on path DB name; app uses MONGODB_DB_NAME
MONGODB_URI=mongodb://127.0.0.1:27017

# Dedicated database name
MONGODB_DB_NAME=hyper_vpn

# Server
PORT=8000
# Comma-separated list of allowed web origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://hypervpn.oxmite.com,https://hyper-vpn-admin.oxmite.com,https://vpnsbackend.oxmite.com,https://vpnsadmin.oxmite.com,https://adminofallapss.oxmite.com,https://allappsadminreact.oxmite.com

# Auth (kept for admin/user compatibility - JWT + optional Google)
JWT_SECRET=change-me-to-a-long-random-string
# Google Sign-In: Web client ID from Google Cloud (used to verify idToken)
GOOGLE_CLIENT_ID=689913059892-2tt7463cfit13k1aolv4bl55qb4n126k.apps.googleusercontent.com

# Gmail for OTP / password reset (optional in dev - OTP is logged if unset)
EMAIL_USER=
EMAIL_PASS=

# OpenAI (chat completion for FAQ support)
OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Admin dashboard authentication
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@gmail.com
ADMIN_JWT_SECRET=change-me-admin-secret
# Must match the per-app service key configured in AllAppsAdmin.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-service-key
# Used by vpnadminbackend when pulling users/usage or banning users from this app:
# base URL: https://your-backend.example.com
# header: X-Service-Key: same value as INTERNAL_SERVICE_KEY
# Optional legacy key for direct knowledge writes; AllAppsAdmin uses INTERNAL_SERVICE_KEY.
KNOWLEDGE_API_KEY=

# Push notifications (Firebase Admin service account JSON as one-line string)
# Important: in private_key use escaped newlines (\\n), not raw line breaks.
# Example:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...,"private_key":"-----BEGIN PRIVATE KEY-----\\nABC...\\n-----END PRIVATE KEY-----\\n",...}
FIREBASE_SERVICE_ACCOUNT=
# Same as admin-service style: JSON string or base64-encoded JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional path to service account file (default: ./firebase-service-account.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Apple in-app purchases (App Store Server API)
# Bundle ID of the iOS app. Purchases from any other app are rejected.
APPLE_BUNDLE_ID=com.speckpro.securevpn.pro
# App Store Connect > Users and Access > Integrations > In-App Purchase
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
# Contents of the .p8 file on one line, with \n in place of each line break.
APPLE_IAP_PRIVATE_KEY=
# Leave false: production is tried first and sandbox is the fallback, so
# TestFlight, App Review and real purchases all work. true = sandbox only.
APPLE_IAP_SANDBOX=false

# Sign in with Apple
# APPLE_BUNDLE_ID (above) is also the audience of the Apple identity token.
# The three below are only needed to revoke the Apple sign-in when a user
# deletes their account (App Store requirement). Create a key with
# "Sign in with Apple" enabled at developer.apple.com > Keys.
APPLE_TEAM_ID=5Q368JT859
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# OpenAI key from the key service (openai-key-service/, deployed on Render).
# When the token is set the key is read from the service and OPENAI_API_KEY
# above is only a fallback. The token must equal ADMIN_TOKEN on the service.
# Put the real token in .env only, never in this file.
ADMIN_TOKEN=
# Optional: defaults to https://openaikeysecret.oxmite.com
OPENAI_KEY_SERVICE_URL=
